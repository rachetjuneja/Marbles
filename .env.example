# ---------------------------------------------------------------------------
# Sales OS — Marble Visualiser: environment
# Copy this file to .env.local and fill in what you have. The app RUNS locally
# with no keys at all (in-memory), but to actually GENERATE a render you need at
# least one image-model key below. Supabase is optional for local dev and
# recommended for production (persistence + the QR upload handoff across devices).
# ---------------------------------------------------------------------------

# Public base URL (used to build the QR upload link). In dev this is fine as-is.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- Image models (add the one(s) you want in the dropdown) ---
# Google Gemini — "Nano Banana" family. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model IDs are configurable because Google iterates fast — confirm the exact id
# in Google AI Studio and adjust if a call 404s.
GEMINI_MODEL_NANO2=gemini-3.1-flash-image        # "Nano Banana 2"
GEMINI_MODEL_PRO=gemini-3-pro-image              # "Nano Banana Pro"
GEMINI_MODEL_CLASSIC=gemini-2.5-flash-image      # original "Nano Banana"

# fal.ai — FLUX.1 Kontext. Get a key at https://fal.ai/dashboard/keys
FAL_KEY=
FAL_MODEL=fal-ai/flux-pro/kontext/max/multi

# OpenAI — GPT Image. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# --- Supabase (optional locally, recommended in production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
